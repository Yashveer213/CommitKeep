{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commitkeep-scheduler",
  "main": "workers/scheduler.ts",
  "compatibility_date": "2026-09-14",
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "API_BASE_URL": "https://YOUR-APP-URL" },
  "observability": { "enabled": true }
}
