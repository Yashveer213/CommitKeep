{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commitkeep-scheduler",
  "main": "workers/scheduler.ts",
  "compatibility_date": "2026-09-14",
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "API_BASE_URL": "https://commitkeep-staging.mkyash40.workers.dev" },
  "services": [{ "binding": "APP", "service": "commitkeep-staging" }],
  "observability": { "enabled": true }
}
